# Defaults run locally without cloud accounts or paid resources.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
PRODUCT_NAME=Sideleaf
# Set a random value of at least 32 characters before deployment.
# Development generates a persistent local secret automatically.
BETTER_AUTH_SECRET=
# Empty: embedded PostgreSQL in local app data, outside synced source folders.
# Required in production, including sslmode=verify-full.
# Vercel runtime should use the Supabase transaction pooler.
DATABASE_URL=
# Migration/admin connection, never needed by the request-serving process.
# Use a direct or session-pooler connection. Falls back to DATABASE_URL locally.
MIGRATION_DATABASE_URL=
# Optional override of the local development data directory. Avoid OneDrive.
APP_DATA_DIR=
# Optional verified OIDC provider via Better Auth Google integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Explicitly enable the selected email/password beta login on a hosted environment.
ENABLE_PASSWORD_AUTH=false
FREE_MONTHLY_MINUTES=120
FREE_MEETING_MINUTES=60
PRO_PRICE_USD=29
# Cloud audio and billing are not enabled in this slice.
